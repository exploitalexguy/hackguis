load.Name = "load"
load.Parent = ScreenGui
load.BackgroundColor3 = Color3.new(0, 0, 0)
load.BorderColor3 = Color3.new(1, 0, 0)
load.BorderSizePixel = 2
load.Position = UDim2.new(0, 0, 0, 611)
load.Size = UDim2.new(0, 168, 0, 26)
load.Font = Enum.Font.SourceSans
load.Text = "Press Me To Load"
load.TextColor3 = Color3.new(1, 1, 1)
load.TextScaled = true
load.TextSize = 14
load.TextWrapped = true

-- Scripts

local function CZFBVG_fake_script() -- load.LocalScript 
	local script = Instance.new('LocalScript', load)

	local button = script.Parent
	local frame = button.Parent:FindFirstChild("Frame")
	
	local toggled = false
	local amt = 0
	
	button.MouseButton1Down:Connect(function()
		if amt == 0 then
			local message = Instance.new("Message")
			message.Parent = script.Parent.Parent.Parent
			message.Text = 'c00lgui has loaded.'
			wait(1)
			message:Destroy()
			amt = 1
		end
		if frame then
			toggled = not toggled
			if toggled then
				button.Text = "Open"
			else
				button.Text = "Close"
			end
			frame.Visible = toggled
		end
	end)
end
coroutine.wrap(CZFBVG_fake_script)()
